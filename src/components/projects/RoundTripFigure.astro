---
// Static figure: MEDFORD text is parsed into a tree, and --out writes it back.
interface Props { label: string }
const { label } = Astro.props;

type P = [number, number];
// Arrowhead triangle at `tip`, pointing away from `from`.
const arrow = (tip: P, from: P, size = 7) => {
  const dx = tip[0] - from[0], dy = tip[1] - from[1];
  const L = Math.hypot(dx, dy);
  const ux = dx / L, uy = dy / L;
  const bx = tip[0] - ux * size, by = tip[1] - uy * size;
  const px = -uy * size * 0.55, py = ux * size * 0.55;
  return `M${tip[0]} ${tip[1]}L${(bx + px).toFixed(1)} ${(by + py).toFixed(1)}L${(bx - px).toFixed(1)} ${(by - py).toFixed(1)}Z`;
};

const docLines = [
  { y: 74, x: 40, w: 44, c: 'l' },
  { y: 86, x: 48, w: 38, c: 'l' },
  { y: 98, x: 48, w: 30, c: 'imp' },
  { y: 110, x: 40, w: 48, c: 'l' },
  { y: 122, x: 48, w: 26, c: 'var' },
  { y: 134, x: 40, w: 40, c: 'l' },
];
const nodes: P[] = [[256, 70], [232, 104], [282, 104], [218, 138], [246, 138], [282, 138]];
const edges: [number, number][] = [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5]];
---
<svg class="figsvg" viewBox="0 0 320 200" role="img" aria-label={label}>
  <!-- document -->
  <rect x="28" y="56" width="74" height="94" rx="7" class="doc" />
  {docLines.map((l) => <path class={`dl ${l.c}`} d={`M${l.x} ${l.y}h${l.w}`} />)}
  <text class="cap" x="65" y="170" text-anchor="middle">MEDFORD text</text>

  <!-- tree -->
  {edges.map(([a, b]) => <path class="te" d={`M${nodes[a][0]} ${nodes[a][1]}L${nodes[b][0]} ${nodes[b][1]}`} />)}
  {nodes.map(([nx, ny], i) => <circle class="tn" cx={nx} cy={ny} r={i === 0 ? 5.5 : i < 3 ? 4.5 : 3.8} />)}
  <text class="cap" x="252" y="170" text-anchor="middle">parsed tree</text>

  <!-- parse (top) -->
  <path class="arc draw" pathLength="1" d="M108 66C136 30 190 28 218 58" />
  <path class="head pop" d={arrow([221, 62], [206, 44])} />
  <text class="lab" x="163" y="30" text-anchor="middle">parse</text>

  <!-- --out (bottom) -->
  <path class="arc out draw" pathLength="1" d="M216 156C190 190 136 192 110 158" />
  <path class="head out pop" d={arrow([107, 154], [120, 172])} />
  <text class="lab out-lab" x="163" y="194" text-anchor="middle">--out</text>

  <!-- what the round trip preserves -->
  <g class="pop keeps">
    <text x="128" y="100"><tspan class="ok">✓</tspan> nested imports</text>
    <text x="128" y="118"><tspan class="ok">✓</tspan> variables</text>
  </g>
</svg>

<style>
  .doc { fill: none; stroke: var(--muted); stroke-width: 1.5; }
  .dl { stroke: var(--muted); stroke-width: 3; stroke-linecap: round; opacity: 0.55; }
  .dl.imp { stroke: var(--data); opacity: 1; }
  .dl.var { stroke: var(--accent); opacity: 1; }
  .te { stroke: var(--data); stroke-width: 1.5; }
  .tn { fill: var(--data); stroke: var(--surface); stroke-width: 2; }
  .cap, .lab, .keeps text { font-family: var(--font-mono); }
  .cap { font-size: 9.5px; fill: var(--muted); }
  .lab { font-size: 10.5px; fill: var(--muted); }
  .out-lab { fill: var(--text); font-weight: 500; }
  .arc { fill: none; stroke: var(--muted); stroke-width: 1.6; stroke-linecap: round; }
  .arc.out { stroke: var(--accent); stroke-width: 2; }
  .head { fill: var(--muted); }
  .head.out { fill: var(--accent); }
  .keeps text { font-size: 9px; fill: var(--muted); }
  .ok { fill: var(--success); }
</style>
