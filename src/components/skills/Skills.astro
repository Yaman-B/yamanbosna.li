---
// Phase 1: grouped list (tool, then where it was used). The force-directed graph
// arrives in Phase 2; this list stays as its mobile and screen reader version.
import SectionHeader from '../global/SectionHeader.astro';
import { sections, site } from '../../data/site';
import { skillGroups, where } from '../../data/skills';
const s = sections.find((x) => x.id === 'skills')!;
---
<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeader n={s.n} title={s.title} loss={s.loss} id="skills-title" lede="Tools listed by where I've actually used them." />
    <div class="groups">
      {skillGroups.map((g) => (
        <div class="group">
          <h3 class="mono">{g.name}</h3>
          <ul>
            {g.tools.map((t) => (
              <li>
                <span class="tool">{t.name}</span>
                <span class="used">{t.used.map((u) => where[u]).join(' · ')}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="course"><span class="mono">Coursework</span>{site.coursework.join(' · ')}</p>
  </div>
</section>

<style>
  .groups { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .groups { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .group {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(var(--bg-rgb) / 0.7);
    padding: 18px 20px 10px;
  }
  h3 { font-size: 0.8125rem; color: var(--muted); font-weight: 500; margin-bottom: 6px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 9px 0; }
  li + li { border-top: 1px solid var(--border); }
  .tool { font-weight: 500; }
  .used { color: var(--muted); font-size: 0.85rem; text-align: right; }
  .course { margin-top: 28px; color: var(--muted); font-size: 0.95rem; display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .course .mono { color: var(--text); }
</style>
