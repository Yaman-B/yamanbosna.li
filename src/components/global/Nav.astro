---
import { sections, site } from '../../data/site';
interface Props { home?: boolean }
const { home = true } = Astro.props;
const href = (id: string) => (home ? `#${id}` : `/#${id}`);
---
<header class="nav" data-nav>
  <div class="container nav-inner">
    <a class="mark" href={home ? '#top' : '/'} aria-label="Yaman Bosnali, home">yb</a>

    <nav class="links" aria-label="Sections">
      <ul>
        {sections.map((s) => <li><a href={href(s.id)} data-nav-link={s.id}>{s.title}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      </button>
      <a class="btn btn-primary resume" href={site.resume} target="_blank" rel="noopener">Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path class="l1" d="M4 8h16"/><path class="l2" d="M4 16h16"/></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <ul class="container">
      {sections.map((s) => (
        <li><a href={href(s.id)}><span class="mono muted">{s.n}</span>{s.title}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .nav.scrolled, .nav.open {
    background: rgb(var(--bg-rgb) / 0.9);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
  }
  .mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.03em;
    padding: 8px 4px;
  }
  .mark:hover { color: var(--accent); }
  .links { margin-left: auto; display: none; }
  .links ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .links a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 160ms var(--ease);
  }
  .links a:hover, .links a.active { color: var(--text); }
  .links a.active { background: var(--surface); }
  .actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    color: var(--text);
  }
  .icon-btn:hover { border-color: var(--accent); }
  .icon-btn svg { width: 20px; height: 20px; }
  .resume { min-height: 44px; padding-inline: 16px; }

  /* Sun shows in dark themes (to switch to paper), moon in light */
  .i-moon { display: none; }
  :global(:root[data-theme='light']) .i-sun { display: none; }
  :global(:root[data-theme='light']) .i-moon { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .i-sun { display: none; }
    :global(:root:not([data-theme='dark'])) .i-moon { display: block; }
  }

  .mobile-menu { border-top: 1px solid var(--border); }
  .mobile-menu ul { list-style: none; margin: 0; padding-block: 8px 20px; }
  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.6rem;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 900px) {
    .links { display: block; }
    .actions { margin-left: 8px; }
    .menu-btn { display: none; }
    .mobile-menu { display: none !important; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 80);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme toggle (PRD 6.4)
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const mq = window.matchMedia('(prefers-color-scheme: light)');
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (mq.matches ? 'light' : 'dark');
  const label = () => toggle.setAttribute('aria-label', current() === 'dark' ? 'Switch to paper theme' : 'Switch to night theme');
  label();
  mq.addEventListener('change', label);
  toggle.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });

  // Mobile menu
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    nav.classList.toggle('open', open);
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
  });

  // Active section highlight
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((a) => links.set(a.dataset.navLink!, a));
  if (links.size && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const a = links.get(e.target.id);
          if (!a) continue;
          if (e.isIntersecting) {
            links.forEach((l) => { l.classList.remove('active'); l.removeAttribute('aria-current'); });
            a.classList.add('active');
            a.setAttribute('aria-current', 'true');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    links.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
  }
</script>
