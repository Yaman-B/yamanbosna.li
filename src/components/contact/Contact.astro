---
import SectionHeader from '../global/SectionHeader.astro';
import { sections, site } from '../../data/site';
const s = sections.find((x) => x.id === 'contact')!;
const rings = [
  [70, 30], [54, 24], [40, 17.5], [27, 12], [15, 7],
];
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container grid">
    <div>
      <SectionHeader n={s.n} title="Let's talk." loss={s.loss} id="contact-title" />
      <p class="line">Open to full-time data science and ML roles from summer 2027. The fastest way to reach me is email.</p>

      <div class="email">
        <a class="addr" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="btn copy" type="button" data-copy={site.email}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg>
          <span data-copy-label>Copy</span>
        </button>
        <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
      </div>

      <div class="links">
        <a class="btn" href={site.links.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        <a class="btn" href={site.links.github} target="_blank" rel="me noopener">GitHub</a>
        <a class="btn" href={site.links.kaggle} target="_blank" rel="me noopener">Kaggle</a>
        <a class="btn btn-primary" href={site.resume} target="_blank" rel="noopener">Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
      </div>
    </div>

    <figure class="basin" aria-hidden="true">
      <svg viewBox="0 0 180 90">
        {rings.map(([rx, ry], i) => (
          <ellipse cx="90" cy="45" rx={rx} ry={ry} transform="rotate(-8 90 45)" class={i === 0 ? 'r outer' : 'r'} />
        ))}
        <circle cx="90" cy="45" r="5.5" class="pt" />
      </svg>
      <figcaption class="mono"><span class="ok">✓</span> loss 0.003 · converged</figcaption>
    </figure>
  </div>
</section>

<style>
  .contact { padding-bottom: 96px; }
  .grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1024px) { .grid { grid-template-columns: 7fr 5fr; gap: 64px; } }
  .line { font-size: 1.15rem; max-width: 40ch; margin-top: -16px; }
  .email { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 32px; }
  .addr {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.85rem + 0.9vw, 1.35rem);
    color: var(--text);
    text-decoration-color: var(--accent);
    word-break: break-all;
  }
  .addr:hover { color: var(--accent); }
  .copy { min-height: 40px; padding: 8px 14px; font-size: 0.9rem; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .basin { margin: 0; justify-self: center; width: 100%; max-width: 360px; }
  .r { fill: none; stroke: var(--muted); stroke-width: 1; opacity: 0.45; }
  .r.outer { opacity: 0.25; }
  .pt { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }
  figcaption { text-align: center; color: var(--success); margin-top: 8px; }
  .ok { margin-right: 4px; }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      if (label) label.textContent = 'Copied';
      if (status) status.textContent = 'Email address copied to clipboard';
      setTimeout(() => {
        if (label) label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    } catch {
      window.location.href = `mailto:${btn.dataset.copy}`;
    }
  });
</script>
